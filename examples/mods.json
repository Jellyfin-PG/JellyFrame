  {
    "id": "now-playing",
    "name": "Now Playing",
    "author": "grimmdev",
    "description": "Shows what's currently playing across all active Jellyfin sessions as a live ticker in the header. Polls every 15 seconds and updates instantly on playback events. Requires the server mod for session data.",
    "version": "1.2.0",
    "createdAt": "2026-01-15",
    "updatedAt": "2026-09-15",
    "jellyfin": "10.10+",
    "tags": [
      "ui",
      "playback",
      "header",
      "server",
      "sessions"
    ],
    "previewUrl": "",
    "screenshots": [],
    "sourceUrl": "https://github.com/Jellyfin-PG/JellyFrame",
    "files": [
      {
        "type": "js",
        "url": "https://cdn.jsdelivr.net/gh/Jellyfin-PG/JellyFrame@main/examples/now-playing-browser.js",
        "version": "1.2.0",
        "date": "2026-09-15",
        "jellyfin": "10.10+",
        "changelog": [
          "Live header ticker UI",
          "Added smooth marquee animation"
        ]
      },
      {
        "type": "server",
        "url": "https://cdn.jsdelivr.net/gh/Jellyfin-PG/JellyFrame@main/examples/now-playing-server.js",
        "version": "1.2.0",
        "date": "2026-09-15",
        "jellyfin": "10.10+",
        "changelog": [
          "Session observer and playback event broadcaster"
        ]
      }
    ],
    "permissions": [
      "jellyfin.read",
      "store",
      "scheduler"
    ],
    "preconnect": [],
    "requires": [],
    "vars": [
      {
        "key": "INSTANCE_LABEL",
        "name": "Instance Label",
        "description": "Label returned by the /sessions endpoint. Useful if you run multiple Jellyfin servers.",
        "type": "text",
        "default": "My Jellyfin"
      },
      {
        "key": "POLL_INTERVAL",
        "name": "Poll Interval (ms)",
        "description": "How often the browser ticker refreshes session data. Default is 15000 (15 seconds). Minimum recommended: 5000.",
        "type": "number",
        "default": "15000"
      },
      {
        "key": "SHOW_USER",
        "name": "Show Username",
        "description": "When enabled, the ticker also shows the username next to the currently playing title.",
        "type": "boolean",
        "default": "false"
      }
    ],
    "changelog": [
      {
        "version": "1.2.0",
        "date": "2026-09-15",
        "changes": [
          "Added smooth marquee ticker animation",
          "Optimized session polling and WebSocket updates"
        ]
      },
      {
        "version": "1.0.0",
        "date": "2026-01-15",
        "changes": [
          "Initial release"
        ]
      }
    ]
  }
]
